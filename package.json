{
  "name": "akhilaariyachandra.com",
  "version": "4.0.0",
  "description": "The code for akhilaariyachandra.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/akhila-ariyachandra/akhilaariyachandra.com.git"
  },
  "author": "Akhila Ariyachandra <akhila_ariyachandra@live.com>",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "prettier:format": "prettier --write \"**/*.{ts,tsx,js,md,css,yaml}\"",
    "prettier:check": "prettier --check \"**/*.{ts,tsx,js,md,css,yaml}\"",
    "sanity:typegen": "sanity schema extract --path=sanity/generated/schema.json --enforce-required-fields --force && sanity typegen generate",
    "knip": "knip",
    "test:e2e": "playwright test",
    "video:sync": "next-video sync"
  },
  "dependencies": {
    "@better-fetch/fetch": "1.3.2",
    "@mux/blurup": "1.0.2",
    "@mux/mux-player-react": "3.14.0",
    "@sanity/asset-utils": "2.3.0",
    "@sanity/client": "8.9.0",
    "@sanity/code-input": "^7.3.12",
    "@sanity/image-url": "2.1.1",
    "@sanity/vision": "6.19.0",
    "@tanstack/highlight": "1.1.0",
    "@varlock/nextjs-integration": "1.2.5",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "cn": "0.5.0",
    "cva": "1.0.0-beta.9",
    "dayjs": "1.11.23",
    "motion": "14.3.0",
    "next": "16.4.2",
    "next-sanity": "13.3.4",
    "next-seo": "7.3.0",
    "next-themes": "0.4.6",
    "next-video": "^2.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "react-icons": "5.7.0",
    "sanity": "6.19.0",
    "sanity-plugin-media": "6.3.5",
    "sanity-plugin-mux-input": "5.2.0",
    "server-only": "0.0.1",
    "slugify": "1.6.9",
    "styled-components": "6.6.0",
    "varlock": "1.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.1",
    "@eslint/js": "9.39.2",
    "@next/playwright": "16.4.2",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "knip": "6.41.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}

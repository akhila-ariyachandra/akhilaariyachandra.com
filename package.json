{
  "name": "akhilaariyachandra.com",
  "version": "4.0.0",
  "description": "The code for akhilaariyachandra.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/akhila-ariyachandra/akhilaariyachandra.com.git"
  },
  "author": "Akhila Ariyachandra <akhila_ariyachandra@live.com>",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "prettier:format": "prettier --write \"**/*.{ts,tsx,js,md,css,yaml}\"",
    "prettier:check": "prettier --check \"**/*.{ts,tsx,js,md,css,yaml}\"",
    "sanity:typegen": "sanity schema extract --path=sanity/generated/schema.json --enforce-required-fields --force && sanity typegen generate",
    "knip": "varlock run -- knip",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mux/blurup": "1.0.2",
    "@mux/mux-player-react": "3.14.1",
    "@sanity/asset-utils": "2.3.0",
    "@sanity/client": "8.16.0",
    "@sanity/code-input": "^7.3.16",
    "@sanity/image-url": "2.2.0",
    "@sanity/vision": "6.23.0",
    "@tanstack/highlight": "1.2.12",
    "@varlock/nextjs-integration": "2.0.1",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "cn": "0.5.2",
    "cva": "1.0.0-beta.9",
    "dayjs": "1.11.23",
    "next": "16.4.6",
    "next-sanity": "13.5.0",
    "next-seo": "7.3.0",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "sanity": "6.23.0",
    "sanity-plugin-media": "6.6.3",
    "sanity-plugin-mux-input": "5.3.1",
    "slugify": "1.6.9",
    "styled-components": "6.6.0",
    "varlock": "1.25.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.30.3",
    "@eslint/js": "9.39.2",
    "@next/playwright": "16.4.6",
    "@playwright/test": "1.65.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.2",
    "knip": "6.45.1",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}

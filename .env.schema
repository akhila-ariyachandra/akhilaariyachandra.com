# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @currentEnv=$APP_ENV
# @defaultRequired=infer @defaultSensitive=true
# @generateTsTypes(path=env.d.ts)
# @encryptInjectedEnv=forEnv(preview, production)
# ----------

# --- Environment ---

# Injected by Vercel on every build and function invocation
# @public @type=enum(development, preview, production)
# @docs(https://vercel.com/docs/environment-variables/system-environment-variables)
VERCEL_ENV=

# Drives which `.env.[APP_ENV]` files load. Set to `test` in CI jobs that don't have secrets
# @public @required @type=enum(development, preview, production, test)
APP_ENV=fallback($VERCEL_ENV, development)

# Production domain (without protocol), injected by Vercel. Falls back to localhost when unset
# @public @optional @example=akhilaariyachandra.com
# @docs(https://vercel.com/docs/environment-variables/system-environment-variables)
VERCEL_PROJECT_PRODUCTION_URL=

# --- Sanity ---

# @public @required
# @docs(https://www.sanity.io/docs/content-lake/api-cdn)
NEXT_PUBLIC_SANITY_PROJECT_ID=

# @public @required @example=production
NEXT_PUBLIC_SANITY_DATASET=

# Sanity API version date. Defaults to the value in `sanity/env.ts` when unset
# @public @optional @example=2026-08-08
NEXT_PUBLIC_SANITY_API_VERSION=

# Viewer token used for draft mode / live preview
# Also passed to `defineLive` as `browserToken`, which intentionally sends it to the browser in draft mode
# @required=forEnv(development, preview, production) @sensitive={preventLeaks=false}
# @docs(https://www.sanity.io/docs/content-lake/http-auth)
SANITY_API_READ_TOKEN=

# --- Last.fm ---

# Username whose listening history is shown on the site
# @public @required=forEnv(development, preview, production)
LAST_FM_USER=

# @required=forEnv(development, preview, production)
# @docs(https://www.last.fm/api/account/create)
LAST_FM_API_KEY=

# --- Vercel tooling ---

# Written by `vercel env pull`, not read by app code
# @optional
VERCEL_OIDC_TOKEN=
